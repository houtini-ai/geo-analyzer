{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.houtini-ai/geo-analyzer",
  "description": "Generative Engine Optimisation analysis - scores content on the signals that get it cited by ChatGPT, Perplexity and Gemini",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/houtini-ai/geo-analyzer/main/assets/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/houtini-ai/geo-analyzer",
    "source": "github"
  },
  "version": "3.0.5",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@houtini/geo-analyzer",
      "version": "3.0.5",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ANTHROPIC_API_KEY",
          "description": "Anthropic API key, used for the semantic analysis pass",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
